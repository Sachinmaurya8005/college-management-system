# ==============================================================================
# Django Backend Environment Configuration Template (.env.example)
# Copy this file to .env for local development, or add variables to Vercel Settings
# ==============================================================================

# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=django-insecure-change-this-to-a-strong-random-key-in-production-2026

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames/domains, e.g. your-app.vercel.app,gpbansdeeh.up.gov.in)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app

# ==============================================================================
# Database Configuration
# Option A (Cloud PostgreSQL - Recommended for Production Vercel / Neon / Supabase):
# Provide a standard PostgreSQL connection URI in DATABASE_URL:
# DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/gpb_polytechnic_db?sslmode=require
#
# Option B (Local SQLite Development):
USE_SQLITE=True
#
# Option C (Manual PostgreSQL Parameters):
# DB_NAME=gpb_polytechnic_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# ==============================================================================

# CORS Configuration (Comma-separated allowed frontend origins)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-app.vercel.app
